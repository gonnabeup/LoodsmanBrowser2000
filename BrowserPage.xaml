<Page
    x:Class="LoodsmanBrowser2000.BrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Browser2000"
    Focusable="True">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="335*" />
            <RowDefinition Height="82*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Grid.RowSpan="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Дерево объектов"
                           FontWeight="Bold"
                           Margin="0,0,0,5" />

                <GroupBox Grid.Row="1">
                    <TreeView x:Name="tvObjects" />
                </GroupBox>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Grid.RowSpan="2"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      Background="LightGray" />

        <Border Grid.Column="2"
                Grid.RowSpan="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="rowAttributes" Height="*" MinHeight="300" />
                    <RowDefinition Height="5" />
                    <RowDefinition x:Name="rowFilesHost" Height="*" MinHeight="100" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="DarkGray"
                        BorderThickness="0,0,0,1"
                        Margin="0,0,0,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Атрибуты"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5" />

                        <DataGrid x:Name="dgAttributes"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Margin="0,5,0,0"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Наименование"
                                                    Binding="{Binding Name}"
                                                    Width="*">
                                    <DataGridTextColumn.ElementStyle >
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsObligatory}" Value="True">
                                                    <Setter Property="Foreground" Value="#800000"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>

                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Значение"
                                                    Binding="{Binding Value}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter x:Name="splitterFiles"
                              Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="LightGray" />

                <Border x:Name="borderFiles"
                        Grid.Row="2"
                        BorderBrush="DarkGray"
                        BorderThickness="1,0,0,0">
                    <Grid x:Name="gridFiles">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136*"/>
                            <ColumnDefinition Width="251*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="titleFiles"
                                   Grid.Row="0"
                                   Text="Файлы"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5" Grid.ColumnSpan="2" />

                        <DataGrid x:Name="dgFiles"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Margin="0,5,0,0" Grid.ColumnSpan="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Файл"
                                                    Binding="{Binding Name}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Размер"
                                                    Binding="{Binding Size}"
                                                    Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>