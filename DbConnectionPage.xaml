<Page x:Class="LoodsmanBrowser2000.DbConnectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="browser2000.baseselection">

    <Grid Margin="20" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="18.04" />
            <RowDefinition Height="Auto" MinHeight="31.96" />
            <RowDefinition Height="Auto" MinHeight="130.92"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>


        <TextBlock Text="Выбор базы данных" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Выберите тип аутентификации" Grid.ColumnSpan="3" TextAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Windows" TextAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="SQL" TextAlignment="Center"/>

            <Slider  x:Name="slAuthType" Grid.Row="2" Grid.ColumnSpan="2"
                Minimum="0"
                Maximum="1"
                Value="1"
                IsSnapToTickEnabled="True"
                TickFrequency="1"
                TickPlacement="BottomRight"
                ValueChanged="Slider_ValueChanged"
                RenderTransformOrigin="0.5,0.5" Margin="50,0,50,0">
                <Slider.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="-1"/>
                </Slider.RenderTransform>
            </Slider>
        </Grid>


        <ComboBox x:Name="cbDatabases" Grid.Row="2" Height="22" VerticalAlignment="Top"/>


        <StackPanel x:Name="spSQLCredentials" Grid.Row="3" Margin="0,10,0,3">
            <TextBlock Text="Пользователь" TextAlignment="Center"/>
            <TextBox x:Name="tbUser" Text="Администратор" Height="28" Margin="0,5"/>

            <TextBlock Text="Пароль" TextAlignment="Center" Margin="0,10,0,0"/>
            <PasswordBox x:Name="pbPassword" Height="28" Margin="0,5"/>
        </StackPanel>

        <Button Grid.Row="5" Content="Подключиться" Click="ConnectButton_Click" FontSize="14" 
                 Margin="0,10,0,10"/>

    </Grid>
</Page>